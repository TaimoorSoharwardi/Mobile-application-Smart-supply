<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileApplicationSmartSupply">

        <activity
            android:name=".auth.view.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MobileApplicationSmartSupply">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.view.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".auth.view.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".auth.view.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".main.view.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".main.view.OrdersActivity"
            android:exported="false" />

        <activity
            android:name=".main.view.OrderDetailActivity"
            android:exported="false" />

        <activity
            android:name=".main.view.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".main.view.NewRequestActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
